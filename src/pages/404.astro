---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex={true}>
  <section style="padding:80px 0 120px;text-align:center">
    <p class="eyebrow">404</p>
    <h1 style="font-size:40px;margin:12px 0 16px">No receipt for this one.</h1>
    <p class="soft" style="margin-bottom:24px">The page doesn't exist or moved.</p>
    <a class="btn btn-primary" href="/">Back to the ranking</a>
  </section>
</Base>
